# Required. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required by the plant-intel MCP server this app hosts.
# Free key (100 requests/day): https://perenual.com/docs/api
PERENUAL_API_KEY=

# Optional. Adds documented companion listings (CC BY-SA 4.0).
# https://permapeople.org/my/api_keys
PERMAPEOPLE_KEY_ID=
PERMAPEOPLE_KEY_SECRET=

# Optional. Shared-budget enforcement across serverless instances.
# Without these the limiter falls back to per-instance memory, which is fine
# for local development but does not hold a budget in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Test-only. Swaps the real model for the scripted fake.
# ROOTWISE_FAKE_MODEL=1
